<%# ═════════ Modal "Consultar con asesor" (lo abre cualquier botón con data-asesor="motivo") ═════════ %>
<div class="modal" id="modalAsesor" role="dialog" aria-modal="true" aria-labelledby="asesorTitulo" hidden>
  <div class="modal__caja modal__caja--chica">
    <div class="modal__cab">
      <h3 id="asesorTitulo"><span class="punto"></span>Consultar con asesor</h3>
      <button type="button" class="icono-btn icono-btn--claro" data-cerrar aria-label="Cerrar"><%- icono('x') %></button>
    </div>

    <form class="asesor" id="formAsesor" action="/consultas" method="POST" novalidate data-whatsapp="<%= concesionaria.whatsappNumero %>" data-concesionaria="<%= concesionaria.nombre %>">
      <div class="asesor__motivo">
        <span>Unidad / Motivo:</span>
        <p id="asesorMotivo"></p>
        <input type="hidden" name="motivo" id="asesorMotivoInput">
        <input type="hidden" name="vehiculo_id" id="asesorVehiculoInput">
      </div>

      <label class="campo">
        <span>Nombre y Apellido *</span>
        <input type="text" name="nombre" required maxlength="80" autocomplete="name" placeholder="Ej: Lucas Fernández">
        <small class="campo__error" data-error="nombre"></small>
      </label>
      <label class="campo">
        <span>WhatsApp / Teléfono *</span>
        <input type="tel" name="telefono" required maxlength="20" autocomplete="tel" inputmode="tel" placeholder="Ej: 381 444-8821">
        <small class="campo__error" data-error="telefono"></small>
      </label>
      <label class="campo">
        <span>Mensaje (Opcional)</span>
        <textarea name="mensaje" rows="2" maxlength="500" placeholder="Quisiera consultar precio final, permuta o financiación..."></textarea>
        <small class="campo__error" data-error="mensaje"></small>
      </label>
      <p class="asesor__aviso" id="asesorAviso" hidden></p>

      <div class="asesor__botones">
        <button type="submit" class="btn btn--naranja btn--bloque"><%- icono('send') %>Enviar Consulta</button>
        <button type="button" class="btn btn--verde btn--bloque" id="asesorWhatsapp"><%- icono('message-circle') %>Iniciar chat por WhatsApp</button>
      </div>
    </form>

    <div class="asesor__listo" id="asesorListo" hidden>
      <div class="asesor__check"><%- icono('check-circle') %></div>
      <h4>¡Consulta Recibida!</h4>
      <p>Un asesor comercial de <strong><%= concesionaria.nombre %></strong> te responderá a la brevedad.</p>
      <button type="button" class="btn btn--azul" data-cerrar>Volver al catálogo</button>
    </div>
  </div>
</div>
