  </main>
</div>

<%# Avisos (toast) y confirmación propia (en lugar del confirm() del navegador) %>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<% if (locals.flash) { %><div id="flash" data-mensaje="<%= flash %>" data-tipo="<%= locals.flashTipo || 'ok' %>" hidden></div><% } %>

<div class="modal" id="modalConfirmar" role="alertdialog" aria-modal="true" aria-labelledby="confirmarTitulo" aria-describedby="confirmarTexto" hidden>
  <div class="modal__caja modal__caja--chica confirmar">
    <div class="confirmar__icono"><%- icono('alert') %></div>
    <h3 id="confirmarTitulo">¿Seguro?</h3>
    <p id="confirmarTexto"></p>
    <div class="confirmar__botones">
      <button type="button" class="btn btn--gris" data-cerrar>Cancelar</button>
      <button type="button" class="btn btn--rojo" id="confirmarSi">Eliminar</button>
    </div>
  </div>
</div>

<script src="/js/base.js"></script>
<script src="/js/admin.js"></script>
<% if (locals.scriptAdmin) { %><script src="/js/<%= scriptAdmin %>.js"></script><% } %>
</body>
</html>
