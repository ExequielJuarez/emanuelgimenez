# Copiá este archivo como .env y completá los valores.

# ── Entorno ─────────────────────────────────────────────────
# En el servidor publicado poné NODE_ENV=production (cookies seguras, caché de archivos).
# En tu computadora dejalo vacío.
NODE_ENV=

# Puerto del servidor (Render y otros hostings lo definen solos)
PORT=3000
# HOST=127.0.0.1 deja la web solo para esta compu (sacalo para abrirla desde el celular)
# HOST=0.0.0.0

# ── Sesión del panel admin ──────────────────────────────────
# Clave para firmar la cookie de sesión. En producción: una frase larga y secreta.
SESSION_SECRET=

# ── Administrador (lo crea `npm run db:instalar`) ───────────
# Si quedan vacíos, el usuario es "admin" y la clave "admin1234".
# ⚠️ En el servidor publicado poné otra clave (o cambiala en el panel → Mi cuenta).
ADMIN_USUARIO=
ADMIN_NOMBRE=Emanuel
ADMIN_CLAVE=

# ── Base de datos MySQL / MariaDB ───────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=emanuelgimenez_automotores
# true para ver en consola las consultas SQL
DB_LOG=false
# Zona horaria de las fechas (Argentina)
DB_TIMEZONE=-03:00
DB_POOL_MAX=5
